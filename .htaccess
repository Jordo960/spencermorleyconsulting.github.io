# ─────────────────────────────────────────────────────────────────────────────
# Spencer Morley Consulting — .htaccess
# Static site security and performance configuration
# Updated: March 25, 2026
# ─────────────────────────────────────────────────────────────────────────────

# Disable directory listing; disable MultiViews so /.well-known/mcp.json
# resolves to the exact file instead of triggering a 300 Multiple Choices
Options -Indexes -MultiViews

# ── SECURITY: block source-control + env files (keep .well-known accessible) ──
# Bots probe /.git/ and /.env/; 404 them so they are never served even if uploaded.
RedirectMatch 404 (?i)/\.git(/|$)
RedirectMatch 404 (?i)/\.env(/|$)

# ── WWW → NON-WWW CANONICAL REDIRECT ─────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── WELL-KNOWN MCP MANIFEST ──────────────────────────────────────────────────
# The MCP manifest is a real file at /.well-known/mcp.json (uploaded via SFTP),
# served directly. No rewrite needed.

# ── LEGACY WORDPRESS URL CLEANUP (post-migration, added 2026-06-14) ───────────
# Old WordPress page URLs that Google indexed now 404 (site rebuilt as static HTML),
# which was de-indexing the site. 301 the real pages to their current homes; 410
# the leftover WordPress theme/demo and system paths so Google drops them fast.
# Specific service rules first, generic /services/ last. NE preserves the # anchor.
RewriteRule ^services/crisis-management/?$ /index.html#crisis-mgmt [R=301,L,NE]
RewriteRule ^services/on-demand-communications/?$ /index.html#on-demand [R=301,L,NE]
RewriteRule ^services/media-relations-training-and-coaching/?$ /index.html#media-relations [R=301,L,NE]
RewriteRule ^services/?$ /index.html#practices [R=301,L,NE]
RewriteRule ^why-us/?$ / [R=301,L]
RewriteRule ^about/?$ /index.html#about [R=301,L,NE]
RewriteRule ^contact/?$ /index.html#contact [R=301,L,NE]

# Legacy/renamed blog URLs Google still crawls (added 2026-06-30). 301 to current homes.
RewriteRule ^blog/seo-in-the-ai-era-alberta-non-profits\.html$ /blog/seo-in-the-ai-era-alberta-small-business.html [R=301,L]
RewriteRule ^blog/municipal-ai-framework-overview\.html$ /municipal.html [R=301,L]
RewriteRule ^blog/municipal-ai-framework-canada\.html$ /municipal.html [R=301,L]

# 410 Gone — legacy WordPress theme/demo content and system paths (no equivalent)
RewriteRule ^(faq-items|portfolio-items|portfolio_category|author)(/|$) - [G]
RewriteRule ^wp-content(/|$) - [G]
RewriteRule ^wp-[^/]*\.php$ - [G]

# ── SECURITY HEADERS ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>

  # Force HTTPS for 1 year (covers all subdomains — wildcard cert in place)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Clickjacking protection — prevent site from being embedded in iframes
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer data sent to third parties
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable unused browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy
  # Allows: inline scripts/styles (required for static HTML), Google Fonts, GA4,
  # Formspree, Meta Pixel (connect.facebook.net) and Calendly booking embeds.
  # 2026-08-05: Facebook + Calendly added. They were missing, so the browser
  # refused fbevents.js and the Calendly iframe for every visitor.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.facebook.com https://connect.facebook.net https://*.calendly.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://formspree.io https://www.facebook.com https://connect.facebook.net https://calendly.com https://*.calendly.com; frame-src https://calendly.com https://*.calendly.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io"

  # ── AI DISCOVERY: advertise machine-readable resources via Link header ──
  # Points AI agents/crawlers at the sitemap, llms.txt guidance file, and MCP
  # manifest at the HTTP layer (satisfies Cloudflare Agent Readiness "Link
  # Headers" check). Registered relation types: sitemap, describedby, service-desc.
  Header always set Link "<https://spencermorleyconsulting.ca/sitemap.xml>; rel=sitemap, <https://spencermorleyconsulting.ca/llms.txt>; rel=describedby, <https://spencermorleyconsulting.ca/.well-known/mcp.json>; rel=service-desc"

  # Suppress server information
  Header always unset Server
  Header always unset X-Powered-By

  # Serve machine-readable discovery files as JSON, with open CORS so AI
  # agents and crawlers can fetch them cross-origin
  <FilesMatch "\.(json)$">
    Header set Content-Type "application/json"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

</IfModule>

# ── CACHE CONTROL ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/plain             "access plus 1 hour"
  ExpiresByType application/xml        "access plus 1 day"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 month"
</IfModule>
